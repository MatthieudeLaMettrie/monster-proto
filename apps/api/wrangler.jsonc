{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monster-proto-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monster-proto-db",
      "database_id": "local-monster-db",
      "migrations_dir": "../../migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY_DO",
        "class_name": "LobbyRoom"
      },
      {
        "name": "BATTLE_DO",
        "class_name": "BattleRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["LobbyRoom", "BattleRoom"]
    }
  ]
}
